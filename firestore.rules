rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow authenticated users full access to leads
    match /leads/{leadId} {
      allow read, write: if request.auth != null;
    }

    // Allow authenticated users full access to interactions
    match /interactions/{interactionId} {
      allow read, write: if request.auth != null;
    }

    // Allow authenticated users full access to observations
    match /observations/{observationId} {
      allow read, write: if request.auth != null;
    }

    // App settings used by the dashboard and profile screens
    match /settings/{settingId} {
      allow read, write: if request.auth != null;
    }

    // Per-user session metadata
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
