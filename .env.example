# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AIzaSyDpYWNTb3X_9-0W67nvrb_7dfdNTnTG3SA"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Private API used by n8n. Use a long random value and send it as:
# Authorization: Bearer YOUR_TOKEN
N8N_API_TOKEN="change-me-with-a-long-random-token"

# Firebase Admin settings used only by /api routes.
FIREBASE_PROJECT_ID="gen-lang-client-0932299961"
FIRESTORE_DATABASE_ID="ai-studio-a6278b9a-2b8a-4ac0-9165-4a9d6ea34455"

# Preferred in Vercel: paste the service account JSON as base64.
# Alternative: use FIREBASE_SERVICE_ACCOUNT_KEY with raw JSON.
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=""
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Optional: if you want this app API to ask n8n to send one email through a webhook.
N8N_EMAIL_WEBHOOK_URL=""
N8N_EMAIL_WEBHOOK_TOKEN=""
